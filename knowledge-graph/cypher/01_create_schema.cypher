CREATE CONSTRAINT language_id_unique IF NOT EXISTS FOR (n:Language) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT language_code_unique IF NOT EXISTS FOR (n:Language) REQUIRE n.language_code IS UNIQUE;
CREATE CONSTRAINT accommodation_id_unique IF NOT EXISTS FOR (n:Accommodation) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT accommodation_code_unique IF NOT EXISTS FOR (n:Accommodation) REQUIRE n.accommodation_code IS UNIQUE;
CREATE CONSTRAINT portfolio_requirement_id_unique IF NOT EXISTS FOR (n:PortfolioRequirement) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT portfolio_requirement_code_unique IF NOT EXISTS FOR (n:PortfolioRequirement) REQUIRE n.portfolio_requirement_code IS UNIQUE;
CREATE CONSTRAINT source_record_id_unique IF NOT EXISTS FOR (n:SourceRecord) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT source_record_code_unique IF NOT EXISTS FOR (n:SourceRecord) REQUIRE n.source_record_code IS UNIQUE;

CREATE RANGE INDEX entity_governance_status IF NOT EXISTS FOR (n:GovernedEntity) ON (n.governance_status);
CREATE RANGE INDEX source_record_location IF NOT EXISTS FOR (n:SourceRecord) ON (n.source_workbook, n.source_sheet, n.source_row);
CREATE FULLTEXT INDEX rsa_discovery IF NOT EXISTS FOR (n:Stream|CareerOutcome|Degree|Institution|Skill|EntranceExam) ON EACH [n.name, n.description];
