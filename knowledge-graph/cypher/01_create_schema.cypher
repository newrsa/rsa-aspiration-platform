CREATE CONSTRAINT degree_id_unique IF NOT EXISTS FOR (n:Degree) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT degree_code_unique IF NOT EXISTS FOR (n:Degree) REQUIRE n.degree_code IS UNIQUE;
CREATE CONSTRAINT institution_type_id_unique IF NOT EXISTS FOR (n:InstitutionType) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT institution_type_code_unique IF NOT EXISTS FOR (n:InstitutionType) REQUIRE n.institution_type_code IS UNIQUE;
CREATE CONSTRAINT institution_id_unique IF NOT EXISTS FOR (n:Institution) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT institution_code_unique IF NOT EXISTS FOR (n:Institution) REQUIRE n.institution_code IS UNIQUE;
CREATE CONSTRAINT admission_pathway_id_unique IF NOT EXISTS FOR (n:AdmissionPathway) REQUIRE n.id IS UNIQUE;
