// RSA SCC Neo4j 5.x schema — idempotent
CREATE CONSTRAINT universe_id_unique IF NOT EXISTS FOR (n:Universe) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT universe_code_unique IF NOT EXISTS FOR (n:Universe) REQUIRE n.universe_code IS UNIQUE;
CREATE CONSTRAINT s_c_c_faculty_id_unique IF NOT EXISTS FOR (n:SCCFaculty) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT s_c_c_faculty_code_unique IF NOT EXISTS FOR (n:SCCFaculty) REQUIRE n.faculty_code IS UNIQUE;
CREATE CONSTRAINT domain_id_unique IF NOT EXISTS FOR (n:Domain) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT domain_code_unique IF NOT EXISTS FOR (n:Domain) REQUIRE n.domain_code IS UNIQUE;
CREATE CONSTRAINT stream_id_unique IF NOT EXISTS FOR (n:Stream) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT stream_code_unique IF NOT EXISTS FOR (n:Stream) REQUIRE n.stream_code IS UNIQUE;
CREATE CONSTRAINT education_stage_id_unique IF NOT EXISTS FOR (n:EducationStage) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT education_stage_code_unique IF NOT EXISTS FOR (n:EducationStage) REQUIRE n.education_stage_code IS UNIQUE;
CREATE CONSTRAINT subject_id_unique IF NOT EXISTS FOR (n:Subject) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT subject_code_unique IF NOT EXISTS FOR (n:Subject) REQUIRE n.subject_code IS UNIQUE;
CREATE CONSTRAINT subject_level_id_unique IF NOT EXISTS FOR (n:SubjectLevel) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT subject_level_code_unique IF NOT EXISTS FOR (n:SubjectLevel) REQUIRE n.subject_level_code IS UNIQUE;
