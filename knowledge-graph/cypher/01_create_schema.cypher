CREATE CONSTRAINT certification_code_unique IF NOT EXISTS FOR (n:Certification) REQUIRE n.certification_code IS UNIQUE;
CREATE CONSTRAINT programme_offering_id_unique IF NOT EXISTS FOR (n:ProgrammeOffering) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT programme_offering_code_unique IF NOT EXISTS FOR (n:ProgrammeOffering) REQUIRE n.programme_offering_code IS UNIQUE;
