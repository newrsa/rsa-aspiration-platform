CREATE CONSTRAINT subject_combination_code_unique IF NOT EXISTS FOR (n:SubjectCombination) REQUIRE n.subject_combination_code IS UNIQUE;
CREATE CONSTRAINT decision_point_id_unique IF NOT EXISTS FOR (n:DecisionPoint) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT decision_point_code_unique IF NOT EXISTS FOR (n:DecisionPoint) REQUIRE n.decision_point_code IS UNIQUE;
CREATE CONSTRAINT criterion_id_unique IF NOT EXISTS FOR (n:Criterion) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT criterion_code_unique IF NOT EXISTS FOR (n:Criterion) REQUIRE n.criterion_code IS UNIQUE;
CREATE CONSTRAINT entrance_exam_id_unique IF NOT EXISTS FOR (n:EntranceExam) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT entrance_exam_code_unique IF NOT EXISTS FOR (n:EntranceExam) REQUIRE n.entrance_exam_code IS UNIQUE;
