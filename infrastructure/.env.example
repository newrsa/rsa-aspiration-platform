# Copy to infrastructure/.env. Never commit the resulting file.
# Generate each secret independently, for example: openssl rand -base64 36

# On the Linux server, use absolute paths on the local NVMe.
RSA_DATA_ROOT=/srv/rsa/data
# Point this at the separately mounted external backup disk.
RSA_BACKUP_ROOT=/mnt/rsa-backups
RSA_NEO4J_IMPORT_ROOT=./datasets

# Keep localhost for a single-machine prototype. On the home server, use its
# Tailscale IPv4 address (100.x.y.z), not 0.0.0.0 or the public/LAN address.
RSA_BIND_ADDRESS=127.0.0.1
RSA_ADVERTISED_HOST=localhost

NEO4J_PASSWORD=replace-with-a-long-random-password
NEO4J_HEAP_SIZE=8g
NEO4J_PAGECACHE_SIZE=28g
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

QDRANT_API_KEY=replace-with-a-long-random-api-key
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

POSTGRES_DB=rsa
POSTGRES_USER=rsa_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432

# Canonical application connection settings for the local stack.
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
QDRANT_URL=http://localhost:6333
DATABASE_URL=postgresql://rsa_app:replace-with-url-encoded-password@localhost:5432/rsa
