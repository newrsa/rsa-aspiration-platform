# Team cloud slice. Copy to .env.cloud outside source control and replace values.
# Keep the same variable names in local and cloud environments.

NEO4J_URI=neo4j+s://replace-me.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-aura-password

QDRANT_URL=https://replace-me.cloud.qdrant.io:6333
QDRANT_API_KEY=replace-with-qdrant-cloud-api-key

DATABASE_URL=postgresql://replace-user:replace-password@replace-host:5432/replace-database?sslmode=require
