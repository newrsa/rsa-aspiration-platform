# Copy this file to infrastructure/.env.poc and replace all three secrets.
# The resulting .env.poc is ignored by Git.

# These satisfy the base Compose contract. Database storage is replaced with
# Docker-managed named volumes by docker-compose.poc.yml.
RSA_DATA_ROOT=./infrastructure/runtime-data
RSA_BACKUP_ROOT=./infrastructure/runtime-backups
RSA_NEO4J_IMPORT_ROOT=./datasets

# Local-only by default. To allow access over Tailscale, use the Windows host's
# 100.x.y.z address here and in RSA_ADVERTISED_HOST, then recreate the stack.
RSA_BIND_ADDRESS=127.0.0.1
RSA_ADVERTISED_HOST=localhost

# Alternate ports avoid clashing with an existing Neo4j Desktop installation.
NEO4J_HTTP_PORT=17474
NEO4J_BOLT_PORT=17687
QDRANT_HTTP_PORT=16333
QDRANT_GRPC_PORT=16334
POSTGRES_PORT=15432

# Reduced memory settings for the 16 GB POC computer.
NEO4J_HEAP_SIZE=1g
NEO4J_PAGECACHE_SIZE=2g

NEO4J_PASSWORD=replace-with-a-long-random-password
QDRANT_API_KEY=replace-with-a-long-random-api-key
POSTGRES_DB=rsa
POSTGRES_USER=rsa_app
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Application connection contract for this POC.
NEO4J_URI=neo4j://localhost:17687
NEO4J_USER=neo4j
QDRANT_URL=http://localhost:16333
DATABASE_URL=postgresql://rsa_app:replace-with-url-encoded-password@localhost:15432/rsa
